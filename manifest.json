{
  "manifest_version": 3,
  "name": "pinguRocks",
  "version": "1.0.1",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["Content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/pingu_01.jpg",
        "assets/pingu_02.jpg",
        "assets/pingu_03.jpg",
        "assets/pingu_04.webp"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}